# Default: fully local inference through Ollama (no API key or per-request fee).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m

# Structured extraction / adjudication
LLM_MODEL=qwen3.5:4b
LLM_MAX_RETRIES=3
LLM_WORKERS=1
LLM_TIMEOUT_SECONDS=600
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=6144

# Semantic candidate generation
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=32
DEDUP_SIMILARITY_THRESHOLD=0.82
ALIGNMENT_RETRIEVAL_THRESHOLD=0.62
ALIGNMENT_TOP_K=16

# PDF parsing. OCR additionally requires a system Tesseract installation.
CHUNK_SIZE_CHARS=3500
CHUNK_OVERLAP_CHARS=250
ENABLE_OCR=true
OCR_LANGUAGE=eng
# Optional override; Conda's share/tessdata directory is discovered automatically.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
MIN_PAGE_TEXT_CHARS=40

# Stop on an individual LLM failure instead of recording it and continuing.
FAIL_FAST=false

# Optional hosted mode. Set LLM_PROVIDER=openai and select OpenAI model names.
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-5.4-mini
# EMBEDDING_MODEL=text-embedding-3-small

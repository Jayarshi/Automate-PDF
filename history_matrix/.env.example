# Copy this file to .env. Never commit the real API key.
OPENAI_API_KEY=

# Structured extraction / adjudication
LLM_MODEL=gpt-5.4-mini
LLM_MAX_RETRIES=3
LLM_WORKERS=4

# Semantic candidate generation
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128
DEDUP_SIMILARITY_THRESHOLD=0.82
ALIGNMENT_RETRIEVAL_THRESHOLD=0.68
ALIGNMENT_TOP_K=12

# PDF parsing. OCR additionally requires a system Tesseract installation.
CHUNK_SIZE_CHARS=9000
CHUNK_OVERLAP_CHARS=700
ENABLE_OCR=false
OCR_LANGUAGE=eng
MIN_PAGE_TEXT_CHARS=40

# Stop on an individual LLM failure instead of recording it and continuing.
FAIL_FAST=false
